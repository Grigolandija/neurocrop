{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean:stale-vendor": "node ./scripts/clean-stale-vendor.mjs",
    "predev": "pnpm clean:stale-vendor",
    "dev": "vite",
    "prebuild": "pnpm clean:stale-vendor",
    "build": "tsc -p tsconfig.app.json --incremental && tsc -p tsconfig.node.json --incremental && vite build",
    "lint": "eslint .",
    "test:architecture": "node ./scripts/test-react-dashboard-invariants.mjs",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "test:e2e:playwright": "playwright test",
    "test": "pnpm test:architecture && pnpm test:css && pnpm test:workspace-access && pnpm test:metric-registry && pnpm test:crop-profiles && pnpm test:greenhouse-map && pnpm test:trend-chart",
    "test:css": "node ./scripts/prune-unused-dashboard-css.mjs --check",
    "test:workspace-access": "vitest run src/state/workspaceAccess.test.ts",
    "test:metric-registry": "vitest run src/domain/metricRegistry.test.ts",
    "test:crop-profiles": "vitest run src/features/settings/cropProfileDefaults.test.ts",
    "test:greenhouse-map": "vitest run src/features/greenhouse-map",
    "test:trend-chart": "vitest run src/features/trends/sharedTrendChart.test.ts",
    "test:bundle": "node ./scripts/check-bundle-budget.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/react": "^6.12.8",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "echarts": "^6.1.0",
    "konva": "^10.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.16",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
