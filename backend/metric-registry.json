    "airTemp": {
      "label": "Air temperature",
      "labelLt": "Oro temperatūra",
      "unit": "°C",
      "decimals": 1,
      "telemetryKey": "temperature",
      "column": "temperature",
      "sensorKey": "sht45",
      "intervalSec": 600,
      "physicalRange": [-80, 80],
      "profile": {
        "enabled": true,
        "section": "climate",
        "optimal": [22, 26],
        "warning": [20, 28],
        "critical": [18, 30],
        "growth": true,
        "warningPadding": [2, 2],
        "criticalPadding": [4, 4]
