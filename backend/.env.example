# Runtime
NODE_ENV=development
API_PORT=3000
TRUST_PROXY_HOPS=0
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173
ALLOW_LOCAL_DEV_ORIGINS=true
SESSION_COOKIE_SECURE=false
SESSION_SAME_SITE=lax
APP_URL=http://127.0.0.1:4173

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=neurocrop
PGPASSWORD=
PGDATABASE=neurocrop
MEASUREMENT_RETENTION_DAYS=35

# Authentication limits
AUTH_LOGIN_RATE_LIMIT=8
AUTH_LOGIN_IP_RATE_LIMIT=40
AUTH_REGISTRATION_RATE_LIMIT=5
AUTH_INVITE_RATE_LIMIT=8

# ChirpStack API
CHIRPSTACK_API_URL=http://127.0.0.1:8090/api
CHIRPSTACK_API_TOKEN=
CHIRPSTACK_APPLICATION_ID=
CHIRPSTACK_DEVICE_PROFILE_ID=
DEFAULT_OTAA_APP_KEY=

# MQTT ingest
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=application/+/device/+/event/up

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=NeuroCrop <noreply@neurocrop.lt>

# Production uses Docker secret files for sensitive values. Never commit a
# populated copy of this file or place credentials in frontend runtime config.
